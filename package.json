{
  "name": "homebridge-konnected-standalone",
  "displayName": "Konnected Standalone",
  "type": "module",
  "version": "0.1.3",
  "description": "Unofficial Homebridge plugin for Konnected alarm panels running ESPHome standalone alarm mode. Native Apple Home alarm tile plus live zone sensors.",
  "author": "Peter Rakolcza",
  "license": "Apache-2.0",
  "homepage": "https://github.com/peterrakolcza/homebridge-konnected-standalone#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterrakolcza/homebridge-konnected-standalone.git"
  },
  "bugs": {
    "url": "https://github.com/peterrakolcza/homebridge-konnected-standalone/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "konnected",
    "esphome",
    "alarm",
    "security-system",
    "standalone"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.20.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "esphome-client": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "@homebridge/hap-nodejs": "^2.2.0"
  }
}
